{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "taekol",
	"main": "src/worker.js",
	"compatibility_date": "2026-08-26",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"],
		"not_found_handling": "404-page",
		"html_handling": "drop-trailing-slash"
	},
	"r2_buckets": [
		{
			"binding": "PAYMENT_PROOFS",
			"bucket_name": "taekol-payment-proofs"
		}
	],
	"ratelimits": [
		{
			"name": "REGISTRATION_RATE_LIMITER",
			"namespace_id": "482716309",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"vars": {
		"TURNSTILE_HOSTNAMES": "taekol.com"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
